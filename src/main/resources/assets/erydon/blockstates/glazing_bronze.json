{
  "multipart": [
    {
      "apply": {
        "model": "erydon:block/glazing/pane/glazing_bronze_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "erydon:block/glazing/pane/glazing_bronze_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "erydon:block/glazing/pane/glazing_bronze_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "erydon:block/glazing/pane/glazing_bronze_side_alt"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "erydon:block/glazing/pane/glazing_bronze_side_alt",
        "y": 90
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "erydon:block/glazing/pane/glazing_bronze_noside"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "erydon:block/glazing/pane/glazing_bronze_noside_alt"
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "erydon:block/glazing/pane/glazing_bronze_noside_alt",
        "y": 90
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "erydon:block/glazing/pane/glazing_bronze_noside",
        "y": 270
      }
    }
  ]
}