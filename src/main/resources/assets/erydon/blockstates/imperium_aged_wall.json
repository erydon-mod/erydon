{
  "multipart": [
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "erydon:block/wall/imperium_wall_post_aged"
      }
    },
    {
      "when": {
        "north": "low"
      },
      "apply": {
        "model": "erydon:block/wall/imperium_wall_side_aged",
        "uvlock": true
      }
    },
    {
      "when": {
        "east": "low"
      },
      "apply": {
        "model": "erydon:block/wall/imperium_wall_side_aged",
        "y": 90,
        "uvlock": true
      }
    },
    {
      "when": {
        "south": "low"
      },
      "apply": {
        "model": "erydon:block/wall/imperium_wall_side_aged",
        "y": 180,
        "uvlock": true
      }
    },
    {
      "when": {
        "west": "low"
      },
      "apply": {
        "model": "erydon:block/wall/imperium_wall_side_aged",
        "y": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "north": "tall"
      },
      "apply": {
        "model": "erydon:block/wall/imperium_wall_side_tall_aged",
        "uvlock": true
      }
    },
    {
      "when": {
        "east": "tall"
      },
      "apply": {
        "model": "erydon:block/wall/imperium_wall_side_tall_aged",
        "y": 90,
        "uvlock": true
      }
    },
    {
      "when": {
        "south": "tall"
      },
      "apply": {
        "model": "erydon:block/wall/imperium_wall_side_tall_aged",
        "y": 180,
        "uvlock": true
      }
    },
    {
      "when": {
        "west": "tall"
      },
      "apply": {
        "model": "erydon:block/wall/imperium_wall_side_tall_aged",
        "y": 270,
        "uvlock": true
      }
    }
  ]
}
