{
  "multipart": [
    {
      "apply": {
        "model": "erydon:block/glazing/pane/selenephos_diaphanes_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "erydon:block/glazing/pane/selenephos_diaphanes_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "erydon:block/glazing/pane/selenephos_diaphanes_side",
