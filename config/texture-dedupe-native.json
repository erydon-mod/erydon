{
  "schema_version": 1,
  "sources": [
    {
      "id": "erydon-native-mc1.20.1",
      "tier": "native",
      "root": "../src/main/resources",
      "namespaces": [
        "erydon",
        "minecraft"
      ],
      "include": [
        "*.png",
        "**/*.png"
      ],
      "exclude": [],
      "role_rules": [
        {
          "glob": "textures/**/*_n.png",
          "role": "normal"
        },
        {
          "glob": "textures/**/*_s.png",
          "role": "specular"
        },
        {
          "glob": "optifine/**/*_n.png",
          "role": "normal"
        },
        {
          "glob": "optifine/**/*_s.png",
          "role": "specular"
        },
        {
          "glob": "textures/optifine/ctm/overlay/**/*.png",
          "role": "overlay"
        },
        {
          "glob": "optifine/ctm/overlay/**/*.png",
          "role": "overlay"
        },
        {
          "glob": "textures/optifine/**/*.png",
          "role": "ctm-albedo"
        },
        {
          "glob": "optifine/**/*.png",
          "role": "ctm-albedo"
        },
        {
          "glob": "textures/gui/**/*.png",
          "role": "ui"
        },
        {
          "glob": "textures/item/**/*.png",
          "role": "item"
        },
        {
          "glob": "textures/entity/**/*.png",
          "role": "entity"
        },
        {
          "glob": "textures/particle/**/*.png",
          "role": "effect"
        },
        {
          "glob": "textures/**/*fire*.png",
          "role": "effect"
        },
        {
          "glob": "textures/**/*flame*.png",
          "role": "effect"
        },
        {
          "glob": "textures/**/oil.png",
          "role": "effect"
        },
        {
          "glob": "textures/**/*overlay*.png",
          "role": "overlay"
        }
      ],
      "metadata_overrides": {},
      "intentionally_native_high_res": [
        "textures/**/*fire*.png",
        "textures/**/*flame*.png",
        "textures/**/oil.png",
        "textures/**/*overlay*.png",
        "textures/optifine/ctm/overlay/**/*.png",
        "optifine/ctm/overlay/**/*.png"
      ]
    }
  ]
}
